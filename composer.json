{
    "name": "misaf/vendra-console",
    "description": "The console (platform admin) panel for the Vendra platform",
    "keywords": [
        "laravel",
        "filamentphp",
        "misaf",
        "vendra",
        "console"
    ],
    "homepage": "https://github.com/misaf/vendra-console",
    "license": "MIT",
    "authors": [
        {
            "name": "Ehsan Mahmoodi",
            "email": "misaf.1990@gmail.com",
            "role": "Developer"
        }
    ],
    "type": "vendra-module",
    "require": {
        "php": "^8.4",
        "awcodes/filament-badgeable-column": "^4.0",
        "filament/filament": "^5.6.8",
        "illuminate/console": "^13.0",
        "illuminate/contracts": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/support": "^13.0",
        "misaf/laravel-email-validation": "^1.0",
        "misaf/vendra-localization": "self.version",
        "misaf/vendra-store": "self.version",
        "misaf/vendra-reseller": "self.version",
        "misaf/vendra-subscription": "self.version",
        "misaf/vendra-support": "self.version",
        "misaf/vendra-tenant": "self.version",
        "spatie/laravel-package-tools": "^1.93.1"
    },
    "autoload": {
        "psr-4": {
            "Misaf\\VendraConsole\\": "src/",
            "Misaf\\VendraConsole\\Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Misaf\\VendraConsole\\Database\\Factories\\": "database/factories/",
            "Misaf\\VendraConsole\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Misaf\\VendraConsole\\Providers\\ConsolePanelServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "phpstan/extension-installer": true
        },
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "support": {
        "issues": "https://github.com/misaf/vendra-console/issues",
        "source": "https://github.com/misaf/vendra-console"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "$schema": "https://getcomposer.org/schema.json"
}